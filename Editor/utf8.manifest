<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- The process code page is UTF-8 (Windows 10 1903+): getenv, fopen and std::filesystem::path::string() then speak
     UTF-8, the engine's string encoding, so a project under any folder name (Korean on an English Windows, Thai on a
     Korean one) works. Older Windows ignores this and keeps the system code page. -->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
